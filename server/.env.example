# PingTop Video Studio server — copy to .env and fill in.
# Never commit the filled-in file; .env is gitignored.

# HTTP port the server listens on. Optional, defaults to 8080.
PORT=8080

# Google Cloud / Firebase project id used for Vertex AI and Firestore.
# Optional only if the service account JSON below carries the same project_id.
GOOGLE_CLOUD_PROJECT=

# Vertex AI region for Veo and Imagen. Optional, defaults to us-central1.
VERTEX_LOCATION=us-central1

# Firebase Storage bucket holding generated videos and images.
# Optional, defaults to <GOOGLE_CLOUD_PROJECT>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# REQUIRED. Raw service account JSON on a single line, used for Firebase Admin
# and Vertex AI. Must contain project_id, client_email and private_key.
# Escaped newlines (\n) inside private_key are restored at load time.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Comma-separated allow-list of user emails. Optional.
# Leave empty to allow every authenticated user.
VIDEO_STUDIO_ALLOWED_EMAILS=

# Comma-separated browser origins permitted by CORS. Optional.
CORS_ORIGINS=http://localhost:5173

# Anthropic API key, used only for prompt enrichment. Optional.
ANTHROPIC_API_KEY=
