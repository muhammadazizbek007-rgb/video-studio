# Firebase Web App config
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_WEB_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Comma-separated emails allowed to access Video Studio (leave empty = allow all)
VITE_VIDEO_STUDIO_ALLOWED_EMAILS=""

# Cloudflare Worker API URL (set after deploying workers/)
VITE_WORKER_URL="https://video-studio-api.YOUR-SUBDOMAIN.workers.dev"

# ─────────────────────────────────────────────────────────────────────────────
# Backend keys — these belong in functions/.env and Worker secrets, NOT here.
#
# Photo and video generation runs entirely on Google Vertex AI (Veo + Imagen).
# It authenticates with the Firebase service account, so there is no API key to
# set: just grant that account the "Vertex AI User" role (roles/aiplatform.user).
#
#   VERTEX_PROJECT_ID       optional override, defaults to the Firebase project
#   VERTEX_LOCATION         optional, defaults to us-central1
#   FIREBASE_STORAGE_BUCKET optional override for generated media storage
#
# Optional, non-generative services:
#   JSON2VIDEO_API_KEY      template slideshow renderer
#   REPLICATE_API_TOKEN     upscaling only (post-processing)
#   ANTHROPIC_API_KEY       prompt enrichment and analysis only
# ─────────────────────────────────────────────────────────────────────────────
