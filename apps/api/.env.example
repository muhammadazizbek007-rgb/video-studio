# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=8080
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/video-studio

# Browser origin of the web app — used for OAuth redirects and the default CORS origin
WEB_APP_URL=http://localhost:5173
# Public origin of this API — used to build the Google OAuth callback URL
API_PUBLIC_URL=http://localhost:8080
# Comma-separated extra browser origins allowed to call the API with cookies
CORS_ORIGINS=

# Signing secret for the short-lived access JWT — at least 32 characters (required)
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Google OAuth client — required unless AUTH_DEV_LOGIN=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allow-list of sign-in emails; empty means any Google account
ALLOWED_EMAILS=
# Enables POST /api/auth/dev-login. Never set to true in production
AUTH_DEV_LOGIN=false

# Google Cloud project that owns Vertex AI — defaults to the service account project_id
GCP_PROJECT_ID=
# Vertex AI region for Veo/Imagen
VERTEX_LOCATION=us-central1
# Service account key file as one line of raw JSON — required unless FAKE_VERTEX=true
GOOGLE_SERVICE_ACCOUNT_JSON=
# Stubs Vertex AI: no network calls, deterministic fake results. Used by E2E
FAKE_VERTEX=false

# Directory holding generated videos and uploads
MEDIA_ROOT=./var/media
# Public URL prefix the stored media is served under
MEDIA_PUBLIC_BASE_URL=/media

# Optional Anthropic key for prompt enrichment; without it prompts pass through unchanged
ANTHROPIC_API_KEY=
# Mounts the MCP StreamableHTTP endpoint at /mcp
MCP_ENABLED=true

# Minimum gap between two Vertex submissions for the same base model, in ms. Vertex
# accepts one generation request per minute per model and refuses the rest with a 429,
# so this mirrors that ceiling. Lower it once Google grants a higher quota. Ignored
# when FAKE_VERTEX=true
VEO_SUBMIT_INTERVAL_MS=60000
# How many times a submission may be refused by the quota before the clip is failed
VEO_SUBMIT_MAX_ATTEMPTS=20
