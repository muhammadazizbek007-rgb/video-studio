# Line endings.
#
# core.autocrlf=true on a Windows clone rewrites LF to CRLF in the WORKING COPY on
# checkout. The committed blobs stay LF, so CI — which checks out on Linux — never
# noticed. But infra/aws/bootstrap-ec2.sh uploads the working copy to the server,
# and a CR at the end of a shebang makes the kernel look for an interpreter named
# literally "bash\r":
#
#   /usr/bin/env: 'bash\r': No such file or directory
#
# Anything that is executed on, or parsed by, the Linux host is pinned to LF here so
# it survives a round trip through a Windows checkout.

* text=auto

*.sh          text eol=lf
*.bash        text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.env         text eol=lf
*.env.example text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
.dockerignore text eol=lf
.nvmrc        text eol=lf
Makefile      text eol=lf

# Binaries must never be touched by eol conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.mp4  binary
*.woff binary
*.woff2 binary
