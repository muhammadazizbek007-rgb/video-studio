# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.output/
.turbo/
# TypeScript's incremental cache. It is rewritten by every build, so tracking it
# means a permanently dirty working tree and a diff on every commit that touches
# nothing anyone wrote.
*.tsbuildinfo

# Environment variables — NEVER commit
.env
.env.local
.env.*.local
!.env.example

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Runtime data (local media storage driver)
var/
data/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Playwright
e2e/playwright-report/
e2e/test-results/
