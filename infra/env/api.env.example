# Production environment for the api container.
#
# Copy to /opt/video-studio/shared/env/api.env on the VPS, fill it in, then:
#   chmod 600 /opt/video-studio/shared/env/api.env
#
# docker compose reads this file verbatim: no quoting, no shell expansion, no
# inline comments after a value. Never commit the filled-in copy.

# --- Runtime -----------------------------------------------------------------
# NODE_ENV, PORT and MEDIA_ROOT are already set by the image and by
# docker-compose.prod.yml; overriding them here is not supported.
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# `mongo` is the compose service name on the internal `data` network. The database
# is not published to the host and has no authentication because nothing outside
# that network can reach it.
MONGODB_URI=mongodb://mongo:27017/video-studio

# --- Public URLs -------------------------------------------------------------
# Both point at the same origin: nginx serves the SPA and proxies /api.
# Used for the Google OAuth redirect and as the default CORS origin.
WEB_APP_URL=https://example.com
API_PUBLIC_URL=https://example.com
# Comma-separated extra browser origins allowed to send cookies. Leave empty for a
# single-origin deployment.
CORS_ORIGINS=

# --- Authentication ----------------------------------------------------------
# Signing secret for the 15-minute access JWT. At least 32 characters.
# Generate with:  openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-openssl-rand-base64-48
# Google OAuth client. The authorised redirect URI must be exactly
# ${API_PUBLIC_URL}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allow-list of sign-in emails. Empty means any Google account can
# sign in — set it for a private deployment.
ALLOWED_EMAILS=
# Enables POST /api/auth/dev-login. MUST stay false in production; the route is
# refused outright when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# --- Google Cloud / Vertex AI ------------------------------------------------
# Project that owns Vertex AI. Defaults to the service account's project_id.
GCP_PROJECT_ID=
# Vertex region serving Veo and Imagen.
VERTEX_LOCATION=us-central1
# The service account key file collapsed onto ONE line of raw JSON. Produce it with:
#   jq -c . service-account.json
# Needs roles/aiplatform.user. Required unless FAKE_VERTEX=true.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Stubs Vertex AI entirely: no network calls, deterministic fake results. Only for
# E2E and smoke tests — leave false in production.
FAKE_VERTEX=false

# --- Media storage -----------------------------------------------------------
# Public URL prefix that generated videos are served under. nginx proxies /media/
# to the api, so this stays a path and not an absolute URL.
MEDIA_PUBLIC_BASE_URL=/media

# --- Optional features -------------------------------------------------------
# Anthropic key for prompt enrichment. Without it POST /api/prompt/enrich returns
# the prompt unchanged instead of failing.
ANTHROPIC_API_KEY=
# Mounts the MCP StreamableHTTP endpoint at /mcp.
MCP_ENABLED=true
