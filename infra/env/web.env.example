# Build-time environment for the web image.
#
# Vite inlines VITE_* variables into the bundle at build time, so this file is
# consumed by the BUILD (GitHub Actions), never by the VPS. There is no web env
# file to place on the server — changing any value here means rebuilding the image.
#
# In CI:
#   docker build -f apps/web/Dockerfile --build-arg VITE_API_URL="$VITE_API_URL" .

# Origin the browser calls the API on.
#
#   empty  -> same origin (the production setup: nginx serves the SPA and proxies
#             /api and /media to the api container). This is the only value that
#             keeps the httpOnly session cookies first-party.
#   value  -> absolute origin, e.g. https://api.example.com, for a split-origin
#             deployment. Then CORS_ORIGINS in api.env must list the web origin and
#             the cookies become cross-site.
VITE_API_URL=
