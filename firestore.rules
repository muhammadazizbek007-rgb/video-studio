rules_version = '2';

// Video Studio — every document belongs to exactly one user.
// The client reads and writes its own generations and elements directly;
// the Cloudflare Worker uses the Admin SDK and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Generation requests. Status and result fields are written by the Worker
    // through the Admin SDK, so the client only needs create/read plus small
    // edits of its own document (e.g. the "saved" flag).
    match /video_generations/{generationId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      // The owner must stay the owner
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Reusable characters, locations and props referenced by @handle
    match /video_elements/{elementId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Per-user settings (Claude API key, MCP URL) are written only by the
    // Worker — never expose them to the client.
    match /videoStudioSettings/{userId} {
      allow read, write: if false;
    }

    // Server-side bookkeeping: rate limits and MCP tokens. Admin SDK only.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    match /mcpTokens/{token} {
      allow read, write: if false;
    }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
